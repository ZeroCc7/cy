OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4o

# 可选：如果 DashScope API Key 与 OPENAI_API_KEY 不同则单独配置
# DASHSCOPE_API_KEY=sk-xxx

# 可选：OpenAI 图像生成专用 Key（默认复用 OPENAI_API_KEY）
# IMAGE_API_KEY=sk-xxx
# IMAGE_BASE_URL=https://api.openai.com/v1

# 推荐：自部署 PostgreSQL。配置后项目数据不再依赖 Supabase。
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/muqi

# 附件存储。默认 local，上传/生成图片会保存在 UPLOAD_DIR，并通过 /uploads/... 访问。
ATTACHMENT_STORAGE=local
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads

# 可选：如果仍想使用 Supabase 作为数据库或附件存储，再配置下面这些。
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_key_here
# SUPABASE_BUCKET=character-images
